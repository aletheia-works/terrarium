{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "aidlc engine adapter codex session-start",
            "timeout": 1800
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "aidlc engine adapter codex record-human-turn",
            "timeout": 1800
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "aidlc engine adapter codex bind-bash-session",
            "timeout": 1800
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "aidlc engine adapter codex deliver-stage-rules",
            "timeout": 1800
          }
        ],
        "matcher": "spawn_agent"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "aidlc engine adapter codex state-transition-guard",
            "timeout": 1800
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "aidlc engine adapter codex reviewer-scope",
            "timeout": 1800
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "aidlc engine adapter codex review-freeze",
            "timeout": 1800
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "aidlc engine adapter codex plan-approval-guard",
            "timeout": 1800
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "aidlc engine adapter codex record-human-turn",
            "timeout": 1800
          }
        ],
        "matcher": "request_user_input"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "aidlc engine adapter codex audit-and-sensors",
            "timeout": 3600
          }
        ],
        "matcher": "apply_patch"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "aidlc engine adapter codex sync-workflow-state",
            "timeout": 1800
          }
        ],
        "matcher": "update_plan"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "aidlc engine adapter codex rebuild-stage-graph",
            "timeout": 1800
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "aidlc engine adapter codex validate-state",
            "timeout": 1800
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "aidlc engine adapter codex log-subagent",
            "timeout": 1800
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "aidlc engine adapter codex continue-workflow",
            "timeout": 3600
          }
        ]
      }
    ]
  }
}
